# JARVIS — copy to .env.local
# The app works fully offline without any of these; the API key unlocks
# the agentic chat brain.

# ── The brain: pick ONE (or neither for the offline planner) ──

# Option A — fully LOCAL brain via Ollama (llama 3.1/3.2, Qwen, Mistral…).
# Runs on your own PC, no cloud, no cost. Takes priority when set.
#   1. install Ollama, run `ollama serve`
#   2. `ollama pull llama3.1`  (use a tool-capable model)
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=llama3.1

# Option B — Anthropic Claude API
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=

# POD automation engine (engines/pod-neo — local run or deployment)
# POD_ENGINE_URL=https://your-pod-engine.vercel.app
# POD_CRON_SECRET=same value as the engine's CRON_SECRET

# Bank linking (read-only balance via Plaid — free keys at plaid.com)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# TikTok Shop Affiliate API (partner.tiktokshop.com — approved partner app)
# TTS_APP_KEY=
# TTS_APP_SECRET=
# TTS_ACCESS_TOKEN=
# TTS_SHOP_CIPHER=
# TTS_AFFILIATE_SEARCH_PATH=/affiliate_seller/202405/marketplace_creators/search

# MCP servers: copy mcp-servers.example.json -> mcp-servers.json (gitignored)

# Phase 1+ (cloud sync) — not required today
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
