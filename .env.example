# JARVIS — copy to .env.local
# The app works fully offline without any of these; the API key unlocks
# the agentic chat brain.

ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=

# POD automation engine (engines/pod-neo — local run or deployment)
# POD_ENGINE_URL=https://your-pod-engine.vercel.app
# POD_CRON_SECRET=same value as the engine's CRON_SECRET

# Bank linking (read-only balance via Plaid — free keys at plaid.com)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Phase 1+ (cloud sync) — not required today
# DATABASE_URL=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
